# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev (default): embedded PGlite, real Postgres compiled to WASM.
# No install, no Docker. Data lives in ./.data/pg
DATABASE_URL="pglite://./.data/pg"
#
# Production / any hosted Postgres — the app switches drivers off the URL
# scheme, nothing else changes. PGlite CANNOT run on serverless hosting, so a
# real Postgres URL is required in production. See DEPLOYMENT.md.
# DATABASE_URL="postgres://user:pass@host:5432/dbname?sslmode=require"

# Connections per process. Defaults to 1 in production (serverless multiplies
# this by the number of live instances) and 5 in development. Raise it on a
# long-lived server.
# DATABASE_POOL_MAX="1"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-openssl-rand-base64-48"

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to run entirely on the offline content adapter.
# The app is fully functional either way; set the key to switch on live
# generation with zero code changes.
ANTHROPIC_API_KEY=""
AI_PROVIDER="auto"            # auto | anthropic | offline
AI_MODEL_PRIMARY="claude-opus-5"
AI_MODEL_FAST="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Text to speech
# ---------------------------------------------------------------------------
# webspeech = browser-native (default, free, no key, works offline)
# elevenlabs / openai adapters are stubbed behind the same interface
TTS_PROVIDER="webspeech"
ELEVENLABS_API_KEY=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# When true, learner data sent to the LLM is stripped of names, emails and
# exact locations before it leaves the process.
AI_REDACT_PII="true"
